{
  "name": "Recipe App (Flask + Flutter)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "postCreateCommand": "bash .devcontainer/setup.sh",
  "forwardPorts": [5000, 8080],
  "portsAttributes": {
    "5000": { "label": "Flask API", "onAutoForward": "notify" },
    "8080": { "label": "Flutter Web", "onAutoForward": "openBrowser" }
  },
  "remoteEnv": {
    "PATH": "${containerEnv:PATH}:/home/vscode/flutter/bin"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "Dart-Code.dart-code",
        "Dart-Code.flutter",
        "ms-python.python"
      ]
    }
  }
}
